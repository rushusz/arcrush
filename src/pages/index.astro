---
// 홈은 임시 목록이다. 인덱스 설계는 작품 페이지 이후에 진행한다.
import Base from "../layouts/Base.astro";
import Wordmark from "../components/common/Wordmark.astro";
import { works } from "../data/works";
---
<Base title="arcrush — Minseok Ryu">
  <div class="p">
    <header><span>Minseok Ryu</span><a class="soft" href="mailto:lunununu99@gmail.com">lunununu99@gmail.com</a></header>
    <div class="hero" style="--accent:#3366CC">
      <Wordmark mode="arc" />
      <Wordmark mode="ar" />
    </div>
    <h1>도시의 단절을 길과 머무는 장소로 바꾸는 건축</h1>
    <ol id="works">
      {works.map((w) => (
        <li style={`--accent:${w.accent}`}>
          {(() => {
            const Tag = w.href ? "a" : "div";
            return (
              <Tag class:list={["row", { off: !w.href }]} href={w.href}>
                <b>{w.no}</b>
                <span class="k">{w.keyword}</span>
                <span>{w.title}</span>
                <span class="q">{w.question}</span>
                <span class="soft t">{w.href ? w.term : "준비 중"}</span>
              </Tag>
            );
          })()}
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  .p { padding: 20px var(--gutter) 64px; max-width: var(--frame-max); margin-inline: auto; }
  header { display: flex; justify-content: space-between; font-size: var(--t-caption); }
  .hero { display: grid; justify-items: start; row-gap: 0.06em; font-size: clamp(3.5rem, 12.5vw, 11.5rem); padding-top: clamp(40px, 7vw, 96px); }
  h1 { font-size: var(--t-question); font-weight: var(--w-light); line-height: 1.3; letter-spacing: -0.02em; max-width: 18em; padding-block: clamp(32px, 5vw, 72px) clamp(40px, 6vw, 88px); }
  ol { border-top: 1px solid var(--ink); }
  li { border-bottom: 1px solid var(--line); }
  .row { display: grid; grid-template-columns: 72px 2fr 3fr 7fr 1fr; gap: 8px 24px; padding-block: 16px; align-items: baseline; }
  a.row:hover span { color: var(--accent); }
  .off, .off b { color: var(--faint); }
  b { font-size: var(--t-section-no); font-weight: var(--w-xlight); line-height: 1; letter-spacing: -0.03em; color: var(--accent); }
  .k { font-size: var(--t-caption); font-weight: var(--w-regular); }
  .soft { color: var(--soft); }
  .t { font-size: var(--t-caption); text-align: right; }
  @media (max-width: 760px) { .row { grid-template-columns: 1fr; } .t { text-align: left; } }
</style>
