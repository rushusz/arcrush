---
// 홈: 포개지는 여섯 장. 표지 한 화면 뒤에 작품이 한 장씩 포개진다.
// position: sticky로 포개고, CSS scroll-snap(proximity)으로 장 경계 가까이에서 멈추면 그 장에 맞춰 준다(스크립트 없음).
import Base from "../layouts/Base.astro";
import Wordmark from "../components/common/Wordmark.astro";
import SiteNav from "../components/common/SiteNav.astro";
import { works, questionHtml } from "../data/works";

const images: Record<string, { src: string; alt: string }> = {
  "a-place-for-water": { src: "/works/a-place-for-water/poster.jpg", alt: "A Place for Water 대표 이미지" },
  "the-porous-campus": { src: "/works/the-porous-campus/hero.jpg", alt: "The Porous Campus 대표 이미지" },
  "living-arcade": { src: "/works/living-arcade/hero.jpg", alt: "Living Arcade 대표 이미지" },
  "epicerie-dobong": { src: "/works/epicerie-dobong/hero.jpg", alt: "Epicerie Dobong 대표 이미지" },
  "re-street-office": { src: "/works/re-street-office/hero.jpg", alt: "RE:STREET Office 대표 이미지" },
  "construction-sequence-simulator": { src: "/home/sim.jpg", alt: "아래층은 완성되고 위층은 윤곽선으로만 그려진 2층 건물 모형. 지금 시공 중인 부재 하나만 주황색이다" },
};
const total = String(works.length).padStart(2, "0");
---
<Base title="arcrush — Minseok Ryu">
  <section class="cover" style="--accent:#3366CC">
    <header><span><strong>Minseok Ryu</strong> &nbsp; AI+Architecture Archive</span><SiteNav current="projects" /></header>
    <div class="mid">
      <div class="hero"><Wordmark mode="arc" /></div>
      <h1>도시의 단절을 길과 머무는 장소로 연결하는 건축</h1>
    </div>
    <ol class="toc">
      {works.map((w) => (
        <li style={`--accent:${w.accent}`}>
          <a href={w.href}><b>{w.no}</b><span class="k">{w.keyword}</span><span class="tt">{w.title}</span></a>
        </li>
      ))}
    </ol>
  </section>

  <main id="works">
    {works.map((_, i) => <i class="snap" style={`top:calc(${i} * 100svh)`} aria-hidden="true"></i>)}
    {works.map((w, i) => {
      const img = images[w.slug];
      return (
        <a class="sheet" href={w.href} style={`--accent:${w.accent}`} aria-label={`${w.no} ${w.title}`}>
          <div class="bar"><span><strong>{w.no}</strong> / {total}</span><span class="soft">{w.term} · {w.site}</span></div>
          <div class="body">
            <div class="txt">
              <b class="no">{w.no}</b>
              <div>
                <p class="kw">{w.keyword}</p>
                <h2>{w.title}</h2>
                <p class="q" set:html={questionHtml(w)} />
              </div>
            </div>
            <div class="pic"><img src={img.src} alt={img.alt} loading={i === 0 ? "eager" : "lazy"} decoding="async" /></div>
          </div>
        </a>
      );
    })}
  </main>
  <footer><span>Minseok Ryu</span><a href="mailto:lunununu99@gmail.com">lunununu99@gmail.com</a></footer>
</Base>

<style>
  /* 표지 */
  .cover { min-height: 100svh; display: flex; flex-direction: column; padding: 20px var(--gutter) 28px; max-width: var(--frame-max); margin-inline: auto; }
  header { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; font-size: var(--t-caption); }
  header strong, .bar strong { font-weight: var(--w-regular); }
  .soft { color: var(--soft); }
  .mid { flex: 1; display: flex; flex-direction: column; justify-content: center; padding-block: 40px; }
  .hero { font-size: calc(var(--t-question) * 1.2); }
  h1 { font-size: var(--t-question); font-weight: var(--w-light); line-height: 1.3; letter-spacing: -0.02em; color: #6f6c68; padding-top: clamp(14px, 2vw, 28px); }
  .toc { display: grid; grid-template-columns: repeat(6, 1fr); border-top: 1px solid var(--ink); }
  .toc a { display: grid; gap: 2px; padding: 12px 12px 0 0; font-size: var(--t-caption); line-height: 1.5; }
  .toc b { font-size: 1.5rem; font-weight: var(--w-xlight); letter-spacing: -0.03em; line-height: 1.2; color: var(--accent); }
  .toc .k { font-weight: var(--w-regular); }
  .toc .tt { color: var(--soft); }
  .toc a:hover .tt { color: var(--accent); }

  /* 접속할 때 띄어쓰기가 한 번 움직인다: arc rush → ar crush → arc rush */
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .hero :global(.wm .c) { animation: hinge 1.5s 0.5s cubic-bezier(0.6, 0, 0.2, 1) 1 both; }
    .hero :global(.wm .a) { animation: thin 1.5s 0.5s 1 both; }
    .hero :global(.wm .r) { animation: thick 1.5s 0.5s 1 both; }
  }
  @keyframes hinge { 0%, 100% { margin: 0 var(--gap) 0 0; } 38%, 62% { margin: 0 0 0 var(--gap); } }
  @keyframes thin { 0%, 24%, 76%, 100% { font-weight: 400; } 25%, 75% { font-weight: 200; } }
  @keyframes thick { 0%, 24%, 76%, 100% { font-weight: 200; } 25%, 75% { font-weight: 400; } }
  /* 터치 화면에서는 띄어쓰기 없이 arcrush로 두고 c만 강조한다(홈과 같은 규칙). */
  @media (hover: none) {
    .hero :global(.wm .c) { margin: 0 !important; }
    .hero :global(.wm i:not(.c)) { font-weight: var(--w-light) !important; }
  }

  /* 작품 장: 화면 위에 붙어 있고 다음 장이 그 위로 올라온다 */
  .sheet { position: sticky; top: 0; display: flex; flex-direction: column; min-height: 100svh; background: var(--paper); border-top: 1px solid var(--ink); padding: 14px var(--gutter) 28px; }
  .bar { display: flex; justify-content: space-between; gap: 16px; font-size: var(--t-caption); width: 100%; max-width: calc(var(--frame-max) - 2 * var(--gutter)); margin-inline: auto; }
  .body { flex: 1; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(24px, 4vw, 64px); align-items: end; width: 100%; max-width: calc(var(--frame-max) - 2 * var(--gutter)); margin-inline: auto; padding-top: 24px; }
  .txt { align-self: stretch; display: flex; flex-direction: column; justify-content: space-between; }
  .no { display: block; font-size: var(--t-work-no); font-weight: var(--w-xlight); line-height: 0.9; letter-spacing: -0.05em; color: var(--accent); margin-left: -0.04em; }
  .kw { font-size: var(--t-caption); font-weight: var(--w-regular); letter-spacing: 0.08em; padding-top: clamp(16px, 2.4vw, 32px); }
  h2 { font-size: var(--t-title); font-weight: var(--w-light); line-height: 1.08; letter-spacing: -0.03em; padding-top: 4px; }
  .q { font-size: clamp(1.0625rem, 1.5vw, 1.375rem); line-height: 1.5; letter-spacing: -0.02em; color: #6f6c68; padding-top: clamp(12px, 1.6vw, 22px); max-width: 26em; }
  .q { text-wrap: balance; }
  .q :global(em) { color: var(--accent); font-weight: var(--w-regular); }
  .q :global(.qb) { display: none; } /* 홈의 장은 열이 좁아 줄바꿈을 브라우저에 맡긴다 */
  .pic { align-self: stretch; display: flex; align-items: flex-start; min-height: 0; }
  .pic img { width: 100%; height: auto; max-height: calc(100svh - 110px); object-fit: cover; aspect-ratio: 16 / 10; }
  @media (hover: hover) {
    .pic img { transition: opacity 0.3s; }
    .sheet:hover .pic img { opacity: 0.9; }
    .sheet:hover h2 { color: var(--accent); }
  }

  /* 장마다 멈추는 자리. sticky 요소에는 snap을 걸 수 없어 보이지 않는 표시를 따로 둔다. */
  main { position: relative; }
  .snap { position: absolute; left: 0; width: 1px; height: 1px; scroll-snap-align: start; pointer-events: none; }
  .cover { scroll-snap-align: start; }
  footer { scroll-snap-align: end; }
  footer { position: relative; background: var(--paper); border-top: 1px solid var(--ink); display: flex; justify-content: space-between; padding: 14px var(--gutter) 28px; font-size: var(--t-caption); color: var(--soft); }

  @media (max-width: 760px) {
    .toc { grid-template-columns: repeat(3, 1fr); row-gap: 8px; }
    .body { grid-template-columns: 1fr; grid-template-rows: minmax(0, 1fr) auto; align-items: stretch; gap: 20px; padding-top: 16px; }
    .pic { order: -1; align-self: auto; }
    .txt { align-self: end; display: block; }
    .pic { min-height: 0; }
    .pic img { height: 100%; max-height: none; aspect-ratio: auto; }
    .no { font-size: clamp(3.25rem, 16vw, 4.5rem); }
  }
  /* 낮은 화면(눕힌 휴대폰 등)에서는 장이 잘리지 않도록 포개기를 푼다 */
  @media (max-height: 620px) { .sheet { position: static; } .pic img { max-height: none; } .snap { display: none; } }
</style>
<style is:global>
  /* 홈에서만: 장 경계 가까이에서 멈추면 그 장에 맞춰 준다(느슨한 방식). 낮은 화면에서는 장이 화면보다 길어질 수 있어 끈다. */
  @media (min-height: 621px) { html:has(#works) { scroll-snap-type: y proximity; } }
</style>
