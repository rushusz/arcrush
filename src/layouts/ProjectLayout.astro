---
// 작품 페이지 공통 틀(B안). 블록 순서·번호·레일은 여기서 고정한다. 프로젝트 세션은 슬롯만 채운다.
// 슬롯: image, context, process, technique, drawings, outcome, credits
import Base from "./Base.astro";
import Wordmark from "../components/common/Wordmark.astro";
import SiteNav from "../components/common/SiteNav.astro";
import { workBySlug } from "../data/works";
import { sentencePerLine } from "../lib/sentences";

interface Props { slug: string; specs?: Record<string, string> }
const { slug, specs = {} } = Astro.props;
const { work, prev, next } = workBySlug(slug);

const [before, after] = work.question.split(work.emphasis);
const allSpecs: Record<string, string> = { term: work.term, site: work.site, status: work.status, keyword: work.keyword, ...specs };

const defs = [
  ["context", "Context"],
  ["process", "Process"],
  ["technique", "Technique"],
  ["drawings", "Drawings"],
  ["outcome", "Outcome"],
  ["credits", "Credits"],
] as const;
const hasImage = Astro.slots.has("image");
const image = hasImage ? await Astro.slots.render("image") : "";
const blocks = await Promise.all(
  defs.filter(([n]) => Astro.slots.has(n)).map(async ([name, label], i) => ({
    name, label, no: String(i + (hasImage ? 2 : 1)).padStart(2, "0"), html: sentencePerLine(await Astro.slots.render(name)),
  })),
);
const index = [...(hasImage ? [{ name: "image", label: "Image" }] : []), ...blocks];
---
<Base title={`${work.no} ${work.title} — arcrush`} description={work.question} image={`/og/${work.slug}.jpg`}>
  <div class="f" style={`--accent:${work.accent}`}>
    <div id="level" aria-hidden="true"></div>
    <aside class="r">
      <div>
        <p class="brand"><a href="/"><Wordmark mode={work.status === "tool" ? "ar" : "arc"} /></a><br /><span>Minseok Ryu</span></p>
        <div class="site"><SiteNav current="projects" /></div>
      </div>
      <ul class="idx">
        {index.map((b, i) => <li data-target={`b-${b.name}`} class={i === 0 ? "on" : ""}><a href={`#b-${b.name}`}>{b.label}</a></li>)}
      </ul>
      <nav class="pn" aria-label="작품 이동">
        <a href={prev.href} aria-label={`이전 작품 ${prev.title}`}>← {prev.no}</a>
        <a href="/#works">Projects</a>
        <a href={next.href} aria-label={`다음 작품 ${next.title}`}>{next.no} →</a>
      </nav>
    </aside>

    <main class="c">
      <div class="kw"><span>{work.keyword} {work.keywordKo}</span><span class="soft">Sheet {work.no} / 06</span></div>
      <header class="ti">
        <div class="no">{work.no}</div>
        <div>
          <h1>{work.title}</h1>
          <p class="q">{before}<em>{work.emphasis}</em>{after}</p>
        </div>
      </header>
      <dl class="t">
        {Object.entries(allSpecs).map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>

      {hasImage && <section id="b-image" class="bleed" aria-label="Image"><Fragment set:html={image} /></section>}

      {blocks.map((b) => (
        <section id={`b-${b.name}`} aria-labelledby={`h-${b.name}`}>
          <div class="hd"><b>{b.no}</b><h2 id={`h-${b.name}`}>{b.label}</h2></div>
          <Fragment set:html={b.html} />
        </section>
      ))}

      <footer class="foot"><span>Minseok Ryu</span><a href="mailto:lunununu99@gmail.com">lunununu99@gmail.com</a></footer>
    </main>
  </div>
</Base>

<script>
  const level = document.getElementById("level") as HTMLElement;
  const items = [...document.querySelectorAll<HTMLElement>(".idx li")];
  const update = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    level.style.height = `${max > 0 ? (scrollY / max) * 100 : 0}vh`;
    let current = items[0];
    for (const li of items) {
      const el = document.getElementById(li.dataset.target ?? "");
      if (el && el.getBoundingClientRect().top < innerHeight * 0.4) current = li;
    }
    items.forEach((li) => li.classList.toggle("on", li === current));
  };
  addEventListener("scroll", update, { passive: true });
  addEventListener("resize", update);
  update();
</script>

<style>
  .f { display: grid; grid-template-columns: var(--rail) minmax(0, 1fr); max-width: var(--frame-max); margin-inline: auto; }
  #level { position: fixed; left: calc(max(0px, (100vw - var(--frame-max)) / 2) + var(--rail)); top: 0; width: 3px; height: 0; background: var(--accent); z-index: 5; }
  .r { position: sticky; top: 0; align-self: start; height: 100vh; padding: 20px 0 20px var(--gutter); display: flex; flex-direction: column; justify-content: space-between; font-size: var(--t-caption); line-height: 1.5; }
  .brand { font-size: 1rem; line-height: 1.3; }
  .brand span { color: var(--soft); font-size: var(--t-caption); }
  .site { margin-top: 14px; }
  .idx li { font-size: var(--t-rail); line-height: 2.1; color: var(--faint); transition: color 0.2s; }
  .idx li.on { color: var(--ink); font-weight: var(--w-regular); }
  .idx li::before { content: ""; display: inline-block; width: 0; height: 2px; background: var(--accent); vertical-align: middle; transition: width 0.2s; }
  .idx li.on::before { width: 18px; margin-right: 8px; }
  .pn { display: flex; gap: 12px; color: var(--soft); }
  .pn a:hover, .idx a:hover { color: var(--accent); }

  .c { position: relative; padding: 20px var(--gutter) 40px var(--sheet-left); min-width: 0; }
  .c::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 1px; background: var(--line); }
  .kw { display: flex; justify-content: space-between; border-bottom: 1px solid var(--ink); padding-bottom: 10px; font-size: var(--t-caption); line-height: 1.5; }
  .soft { color: var(--soft); }
  .ti { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 36px; margin-top: 64px; align-items: start; }
  .no { font-size: var(--t-work-no); font-weight: var(--w-xlight); line-height: 0.82; letter-spacing: -0.06em; color: var(--accent); }
  h1 { font-size: var(--t-title); font-weight: var(--w-light); letter-spacing: -0.025em; line-height: 1.05; }
  .q { font-size: var(--t-question); line-height: 1.3; letter-spacing: -0.02em; margin-top: 22px; max-width: 19em; }
  .q em { color: var(--accent); font-weight: var(--w-regular); }
  .t { display: grid; grid-template-columns: repeat(4, 1fr); border-block: 1px solid var(--line); margin-top: 56px; font-size: var(--t-caption); line-height: 1.5; }
  .t div { padding: 10px 0; }
  .t dt { color: var(--soft); }
  .bleed { margin: 32px 0 0; }
  .hd { display: flex; align-items: baseline; gap: 14px; border-top: 1px solid var(--ink); padding-top: 10px; margin: var(--block-gap) 0 32px; }
  .hd b { font-size: var(--t-section-no); font-weight: var(--w-xlight); line-height: 1; letter-spacing: -0.03em; color: var(--accent); }
  .hd h2 { font-size: var(--t-rail); font-weight: var(--w-regular); }
  .foot { display: flex; justify-content: space-between; margin-top: var(--block-gap); padding-top: 14px; border-top: 1px solid var(--line); font-size: var(--t-caption); color: var(--soft); }

  @media (max-width: 760px) {
    .f { display: block; }
    #level, .idx, .c::before { display: none; }
    .r { position: static; height: auto; flex-direction: row; align-items: flex-start; padding: 16px var(--gutter) 0; }
    .c { padding: 16px var(--gutter) 40px; }
    .ti { grid-template-columns: 1fr; row-gap: 16px; }
    .t { grid-template-columns: 1fr 1fr; }
  }
</style>
