---
// 과정 전환: 같은 자리에서 그림이 단계별로 바뀐다.
// 조작: 그림을 누르면 다음, 좌우로 밀면 이전·다음, 화살표 버튼과 키보드 ←→, 몇 초마다 자동 전환.
// 자동 전환은 화면에 보일 때만 돌고, 사용자가 직접 조작하면 멈춘다. 움직임 줄이기 설정에서는 자동 전환을 하지 않는다.
import type { Kind } from "./Figure.astro";

interface Step { src: string; alt: string; title: string; text?: string }
interface Props { steps: Step[]; kind: Kind; fig?: string; ratio?: string; interval?: number; note?: string }
const { steps, kind, fig, ratio = "2000 / 952", interval = 4, note } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
---
<figure class="seq" data-interval={interval} aria-roledescription="carousel" aria-label={steps.map((s) => s.title).join(", ")}>
  <div class="stage" style={`aspect-ratio:${ratio}`} tabindex="0" role="button" aria-label="다음 단계 보기">
    {steps.map((s, i) => (
      <img src={s.src} alt={s.alt} class={i === 0 ? "on" : ""} loading={i === 0 ? "eager" : "lazy"} draggable="false" />
    ))}
  </div>
  <figcaption>
    <div class="bar">
      <span class="ct"><b>{pad(1)}</b> / {pad(steps.length)}</span>
      <span class="dots" aria-hidden="true">{steps.map((_, i) => <i class={i === 0 ? "on" : ""}></i>)}</span>
      <span class="nav">
        <button type="button" class="pv" aria-label="이전 단계">←</button>
        <button type="button" class="nx" aria-label="다음 단계">→</button>
      </span>
    </div>
    <div class="cap" aria-live="polite">
      {steps.map((s, i) => (
        <p class={i === 0 ? "on" : ""}>
          <span class="t">{fig && `Fig. ${fig} `}{s.title}</span> · {kind}
          {s.text && <span class="d">{s.text}</span>}
        </p>
      ))}
    </div>
    {note && <p class="n">{note}</p>}
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>(".seq").forEach((el) => {
    const imgs = [...el.querySelectorAll<HTMLImageElement>(".stage img")];
    const caps = [...el.querySelectorAll<HTMLElement>(".cap p")];
    const dots = [...el.querySelectorAll<HTMLElement>(".dots i")];
    const count = el.querySelector(".ct b") as HTMLElement;
    const stage = el.querySelector(".stage") as HTMLElement;
    const n = imgs.length;
    let i = 0;
    let timer: number | undefined;
    let auto = !matchMedia("(prefers-reduced-motion: reduce)").matches;
    let visible = false;

    const show = (k: number) => {
      i = (k + n) % n;
      imgs.forEach((im, j) => im.classList.toggle("on", j === i));
      caps.forEach((c, j) => c.classList.toggle("on", j === i));
      dots.forEach((d, j) => d.classList.toggle("on", j === i));
      count.textContent = String(i + 1).padStart(2, "0");
      imgs[(i + 1) % n].loading = "eager";
    };
    const stop = () => { clearInterval(timer); timer = undefined; };
    const start = () => {
      if (!auto || !visible || timer) return;
      timer = window.setInterval(() => show(i + 1), Number(el.dataset.interval) * 1000);
    };
    const user = (k: number) => { auto = false; stop(); show(k); };

    el.querySelector(".nx")!.addEventListener("click", () => user(i + 1));
    el.querySelector(".pv")!.addEventListener("click", () => user(i - 1));
    stage.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight" || e.key === "Enter" || e.key === " ") { e.preventDefault(); user(i + 1); }
      if (e.key === "ArrowLeft") { e.preventDefault(); user(i - 1); }
    });

    // 누르면 다음, 좌우로 밀면 이전·다음
    let x0: number | null = null;
    stage.addEventListener("pointerdown", (e) => { x0 = e.clientX; });
    stage.addEventListener("pointerup", (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      x0 = null;
      if (Math.abs(dx) < 30) user(i + 1);
      else user(dx < 0 ? i + 1 : i - 1);
    });
    stage.addEventListener("pointercancel", () => { x0 = null; });

    new IntersectionObserver(([en]) => {
      visible = en.isIntersecting;
      visible ? start() : stop();
    }, { threshold: 0.5 }).observe(el);
  });
</script>

<style>
  .stage { position: relative; overflow: hidden; background: var(--track); cursor: pointer; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .stage img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.6s; pointer-events: none; }
  .stage img.on { opacity: 1; }
  figcaption { margin-top: 10px; font-size: var(--t-caption); line-height: 1.5; color: var(--soft); }
  .bar { display: flex; align-items: center; gap: 16px; }
  .ct { font-variant-numeric: tabular-nums; }
  .ct b { font-size: 1.375rem; font-weight: var(--w-xlight); color: var(--accent); letter-spacing: -0.02em; }
  .dots { display: flex; gap: 6px; flex: 1; }
  .dots i { width: 28px; height: 2px; background: var(--line); transition: background 0.3s; }
  .dots i.on { background: var(--accent); }
  .nav { display: flex; gap: 4px; }
  button { all: unset; cursor: pointer; width: 44px; height: 36px; text-align: center; font-size: 1.125rem; font-weight: var(--w-xlight); color: var(--ink); }
  button:hover { color: var(--accent); }
  button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cap { display: grid; margin-top: 2px; }
  .cap p { grid-area: 1 / 1; opacity: 0; visibility: hidden; transition: opacity 0.4s; }
  .cap p.on { opacity: 1; visibility: visible; }
  .t { font-weight: var(--w-regular); color: var(--ink); }
  .d { display: block; color: var(--ink); font-size: var(--t-body); line-height: 1.7; margin-top: 6px; }
  .n { margin-top: 6px; }
</style>
