---
// 대표 인터랙션: 원본 구조 분해 축측(axo.jpg) 한 장을 세 조각으로 잘라 스크롤로 벌린다.
// 길(아케이드) 조각이 맨 먼저 보이고, 위 두 조각이 올라가도 제자리에 남는다.
// 스크립트가 꺼져 있거나 움직임 줄이기 설정이면 다 벌어진 원본 그림을 그대로 보여 준다.
// 좌표는 그림(1200 × 1720 기준)에서 직접 읽었다. 조각 사이의 간격은 원본 그림의 것이며 실제 층고가 아니다.
const src = "/works/living-arcade/axo.jpg";
const W = 1200, H = 1720;
const poly = (pts: number[][]) => `polygon(${pts.map(([x, y]) => `${(x / W * 100).toFixed(2)}% ${(y / H * 100).toFixed(2)}%`).join(",")})`;
// 위 조각과 가운데 조각의 경계, 가운데 조각과 아래 조각의 경계
const upper = [[0, 600], [350, 600], [560, 440], [700, 440], [780, 470], [1100, 640], [1200, 640]];
const lower = [[0, 935], [70, 935], [170, 885], [205, 885], [205, 1010], [530, 1195], [545, 1195], [615, 1150], [690, 1088], [757, 1055], [765, 965], [1035, 805], [1035, 895], [1050, 895], [1135, 850], [1200, 850]];
const clipTop = poly([[0, 0], [W, 0], ...[...upper].reverse()]);
const clipMid = poly([...upper, ...[...lower].reverse()]);
const clipBot = poly([...lower, [W, H], [0, H]]);
// 붙어 있을 때 내려가 있는 거리(그림 높이에 대한 비율)
const dMid = 415 / H * 100, dTop = 775 / H * 100;
const steps = [
  ["도시", "길이 먼저 있다. 아케이드와 통로가 블록을 가로지른다."],
  ["공동체", "길 양쪽에 상점과 공방이 선다. 그 위를 판 하나가 덮고, 판은 원형으로 뚫려 중정이 된다."],
  ["주거", "곡선 주거동이 기둥 위로 올라간다. 길은 제자리에 남는다."],
];
---
<div class="ax" style={`--d-mid:${dMid.toFixed(2)}%;--d-top:${dTop.toFixed(2)}%`}>
  <div class="pin">
    <div class="stage" role="img" aria-label="아래부터 아케이드, 상점과 공방의 저층부, 곡선 주거동 골조의 세 층으로 벌어진 구조 축측도">
      <div class="ly bot" style={`clip-path:${clipBot}`}><img src={src} alt="" width="1800" height="2580" loading="lazy" /><img class="m" src={src} alt="" loading="lazy" /><img class="m" src={src} alt="" loading="lazy" /><i></i></div>
      <div class="ly mid" style={`clip-path:${clipMid}`}><img src={src} alt="" width="1800" height="2580" loading="lazy" /></div>
      <div class="ly top" style={`clip-path:${clipTop}`}><img src={src} alt="" width="1800" height="2580" loading="lazy" /></div>
    </div>
    <ol class="st">
      {steps.map(([t, d], i) => (
        <li class={i === 0 ? "on" : ""}><span class="no">{String(i + 1).padStart(2, "0")}</span><b>{t}</b><span class="d">{d}</span></li>
      ))}
    </ol>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".ax").forEach((el) => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const items = [...el.querySelectorAll<HTMLElement>(".st li")];
    el.classList.add("live");
    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
    const seg = (p: number, a: number, b: number) => Math.min(1, Math.max(0, (p - a) / (b - a)));
    const update = () => {
      const r = el.getBoundingClientRect();
      const span = r.height - innerHeight;
      const p = Math.min(1, Math.max(0, span > 0 ? -r.top / span : 0));
      // 길만 → 저층부가 나타남 → 주거동이 나타남 → 위로 벌어짐
      el.style.setProperty("--f-mid", String(seg(p, 0.12, 0.26)));
      el.style.setProperty("--f-top", String(seg(p, 0.34, 0.48)));
      el.style.setProperty("--e", String(ease(seg(p, 0.56, 0.92))));
      const k = p < 0.12 ? 0 : p < 0.34 ? 1 : 2;
      items.forEach((li, i) => li.classList.toggle("on", i <= k));
    };
    addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update);
    update();
  });
</script>

<style>
  .ax { position: relative; --e: 1; --f-mid: 1; --f-top: 1; }
  .pin { display: flex; gap: 24px clamp(24px, 4vw, 64px); align-items: center; }
  .stage { position: relative; isolation: isolate; background: #fff; aspect-ratio: 1200 / 1720; flex: 0 0 auto; width: min(52%, 560px); overflow: hidden; }
  .ly { position: absolute; inset: 0; mix-blend-mode: multiply; will-change: transform; }
  .ly img { display: block; width: 100%; height: 100%; }
  /* 길 조각: 검은 선을 강조색으로 바꾼다 */
  .bot { isolation: isolate; }
  /* 같은 그림을 곱하기로 겹쳐 옅은 선을 진하게 한다. 흰 바탕은 그대로 흰색이다 */
  .bot .m { position: absolute; inset: 0; mix-blend-mode: multiply; }
  .bot i { position: absolute; inset: 0; background: var(--accent); mix-blend-mode: screen; }
  .mid { transform: translateY(calc((1 - var(--e)) * var(--d-mid))); opacity: var(--f-mid); }
  .top { transform: translateY(calc((1 - var(--e)) * var(--d-top))); opacity: var(--f-top); }

  .st { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px; max-width: 26em; flex: 1 1 0; min-width: 0; }
  .st li { display: grid; grid-template-columns: 2.4em 1fr; column-gap: 8px; align-items: baseline; }
  .no { font-size: var(--t-caption); color: var(--soft); font-variant-numeric: tabular-nums; }
  .st b { font-size: 1.375rem; font-weight: var(--w-xlight); letter-spacing: -0.02em; line-height: 1.3; }
  .d { grid-column: 2; font-size: var(--t-body); line-height: 1.7; margin-top: 4px; }
  .st li:first-child b { color: var(--accent); font-weight: var(--w-regular); }

  /* 스크립트가 켜지면 화면에 고정하고 스크롤로 벌린다 */
  .ax.live { height: 320vh; }
  .ax.live .pin { position: sticky; top: 0; height: 100vh; }
  .ax.live .stage { width: min(56%, calc((100vh - 96px) * 1200 / 1720)); }
  .ax.live .st li { opacity: 0.22; transition: opacity 0.4s; }
  .ax.live .st li.on { opacity: 1; }

  @media (max-width: 760px) {
    .pin { flex-direction: column; justify-content: center; align-items: stretch; }
    .stage { width: 100%; }
    .st { flex: 0 0 auto; }
    .st { gap: 10px; }
    .st b { font-size: 1.125rem; }
    .d { font-size: var(--t-caption); line-height: 1.5; }
    .ax.live { height: 280vh; }
    .ax.live .stage { width: min(100%, calc((100vh - 250px) * 1200 / 1720)); align-self: center; }
  }
</style>
