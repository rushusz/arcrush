---
// 대표 인터랙션: 위로 올라가는 페이지. 스크롤하면 평면이 1층에서 위층으로 바뀌고, 길(Main Street)만 강조색으로 이어진다.
// 평면은 원본 PDF의 같은 자리를 잘라 낸 그림이라 층끼리 정확히 겹친다. 길의 범위는 원본 평면의 계단과
// 동선 축측을 보고 덧그린 것이다(좌표는 쪽 폭을 2000으로 본 값, 자른 범위는 x 255~1840, y 215~1065).
// 스크립트가 꺼져 있거나 움직임 줄이기 설정이면 1층부터 차례로 모든 층을 세로로 보여 준다.
const base = "/works/re-street-office";
const VIEW = "255 215 1585 850";
const TAIL = "1240,565 1530,598 1650,620 1650,668 1440,650 1240,650";
const BAND = "1245,565 1225,648 1035,808 1030,722";
// B-B 단면(section-bb-key.jpg, 원본 y 200~1210)에서 읽은 층 바닥선
const Y = [1180, 1090, 1017, 945, 850, 780, 708, 636, 565, 400];
const band = (a: number, b: number) => `--t:${(((Y[b] - 200) / 1010) * 100).toFixed(2)}%;--h:${(((Y[a] - Y[b]) / 1010) * 100).toFixed(2)}%`;

interface Floor { file: string; name: string; head: string; text: string; street?: string[]; square?: string; at: [number, number] }
const floors: Floor[] = [
  { file: "1f", name: "1층", head: "거리에서", text: "길은 건물 바깥 계단에서 시작한다. 지상은 플리마켓과 팝업 스토어, 플래그십 스토어다.", at: [0, 1],
    street: ["1350,580 1530,598 1650,620 1650,668 1440,650 1350,650"] },
  { file: "2f", name: "2층", head: "공방 사이로", text: "계단을 올라 공방과 커스텀 숍 사이로 들어간다.", at: [1, 2],
    street: [TAIL, "1240,565 1180,605 1095,680 1140,730 1215,712 1215,650 1240,650"] },
  { file: "3f", name: "3층", head: "거래 라운지", text: "길은 대각선으로 꺾여 거래 라운지 앞에 닿는다. 옆으로 세미나실과 프로젝트 랩이 이어진다.", at: [2, 3],
    street: [BAND, "1030,722 880,690 865,765 1030,808"] },
  { file: "4f", name: "4층", head: "계단 쉼터", text: "지붕이 있는 계단 쉼터를 지난다. 로비와 회의장이 이 층에 있다.", at: [3, 4],
    street: [BAND, "1030,722 1000,680 880,655 820,682 760,700 710,700 710,715 835,712 985,750 1030,808", "745,510 1018,558 1000,680 880,655 820,682 745,700 710,700 710,510"] },
  { file: "5f", name: "5층", head: "광장", text: "계단 광장을 오르면 광장이다. 여기까지 누구나 올라올 수 있다.", at: [4, 5],
    street: [BAND, TAIL, "710,497 1018,555 1085,535 1060,655 1030,722 1035,808 785,805 785,690 820,680 710,640"],
    square: "710,805 1420,805 1420,920 710,920" },
  { file: "6f", name: "6층", head: "업무 층", text: "여기서부터 업무 층이다. 가운데를 비워 아래 광장을 내려다본다.", at: [5, 6] },
  { file: "7f", name: "7층", head: "업무 층", text: "업무 공간과 휴게 공간이 빈 곳을 둘러싼다.", at: [6, 7] },
  { file: "8f", name: "8층", head: "업무 층", text: "업무 공간과 휴게 공간이 빈 곳을 둘러싼다.", at: [7, 8] },
  { file: "9-10f", name: "9·10층", head: "업무 층", text: "가장 위의 업무 층이다.", at: [8, 9] },
];
---
<div class="cl">
  <div class="pin">
    <ol class="fl">
      {floors.map((f, i) => (
        <li class={i === 0 ? "on" : ""} data-band={band(f.at[0], f.at[1])}>
          <div class="sheet">
            <img src={`${base}/plan-${f.file}.jpg`} alt={`${f.name} 평면. ${f.text}`} width="2000" height="1073" loading={i === 0 ? "eager" : "lazy"} />
            {(f.street || f.square) && (
              <svg viewBox={VIEW} aria-hidden="true">
                {f.square && <polygon class="sq" points={f.square} />}
                {f.street?.map((p) => <polygon points={p} />)}
              </svg>
            )}
            <span class="bar">20 m</span>
          </div>
          <p class="info"><span class="no">{f.name}</span><b>{f.head}</b><span class="d">{f.text}</span></p>
        </li>
      ))}
    </ol>
    <div class="key" aria-hidden="true">
      <div class="sec">
        <img src={`${base}/section-bb-key.jpg`} alt="" width="1400" height="1537" loading="lazy" />
        <i style={band(0, 1)}></i>
      </div>
      <p class="caption">B-B 단면에서 본 지금 층</p>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".cl").forEach((el) => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const items = [...el.querySelectorAll<HTMLElement>(".fl li")];
    const mark = el.querySelector<HTMLElement>(".sec i")!;
    const n = items.length;
    el.style.setProperty("--n", String(n));
    el.classList.add("live");
    let cur = -1;
    const update = () => {
      const r = el.getBoundingClientRect();
      const span = r.height - innerHeight;
      const p = Math.min(1, Math.max(0, span > 0 ? -r.top / span : 0));
      const k = Math.min(n - 1, Math.floor(p * n));
      if (k === cur) return;
      cur = k;
      items.forEach((li, i) => {
        li.classList.toggle("on", i === k);
        li.classList.toggle("past", i < k);
      });
      mark.setAttribute("style", items[k].dataset.band!);
      const next = items[k + 1]?.querySelector("img");
      if (next) next.loading = "eager";
    };
    addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update);
    update();
  });
</script>

<style>
  .fl { list-style: none; margin: 0; padding: 0; display: grid; gap: 56px; }
  .sheet { position: relative; isolation: isolate; background: #fff; }
  .sheet img { display: block; width: 100%; height: auto; }
  .sheet svg { position: absolute; inset: 0; width: 100%; height: 100%; mix-blend-mode: multiply; }
  polygon { fill: var(--accent); opacity: 0.6; }
  .sq { opacity: 0.22; }
  .bar { position: absolute; right: 2%; bottom: 3%; width: 20%; border-bottom: 2px solid var(--ink); font-size: var(--t-caption); line-height: 1.6; text-align: center; white-space: nowrap; }
  .info { display: grid; grid-template-columns: 4.2em 1fr; column-gap: 8px; align-items: baseline; margin-top: 14px; max-width: 34em; }
  .no { font-size: var(--t-caption); color: var(--soft); font-variant-numeric: tabular-nums; }
  .info b { font-size: 1.375rem; font-weight: var(--w-xlight); letter-spacing: -0.02em; line-height: 1.3; }
  .d { grid-column: 2; font-size: var(--t-body); line-height: 1.7; margin-top: 4px; }
  .key { display: none; }

  /* 스크립트가 켜지면 화면에 고정하고 스크롤로 층을 올라간다 */
  .cl.live { height: calc(var(--n, 9) * 55vh + 100vh); }
  .cl.live .pin { position: sticky; top: 0; height: 100vh; display: grid; grid-template-columns: minmax(0, 1fr) clamp(170px, 20%, 260px); gap: 24px clamp(20px, 3vw, 48px); align-items: center; }
  .cl.live .fl { gap: 0; width: min(100%, calc((100vh - 230px) * 2000 / 1073)); }
  .cl.live .fl li { grid-area: 1 / 1; opacity: 0; visibility: hidden; transform: translateY(-7%); transition: opacity 0.5s, transform 0.6s, visibility 0s 0.6s; }
  .cl.live .fl li.past { transform: translateY(7%); }
  .cl.live .fl li.on { opacity: 1; visibility: visible; transform: none; transition: opacity 0.5s, transform 0.6s; }
  .cl.live .key { display: block; }
  .sec { position: relative; isolation: isolate; }
  .sec img { display: block; width: 100%; height: auto; }
  .sec i { position: absolute; left: 0; right: 0; top: var(--t); height: var(--h); background: var(--accent); opacity: 0.55; mix-blend-mode: multiply; transition: top 0.6s, height 0.6s; }
  .key .caption { margin-top: 8px; }

  @media (max-width: 760px) {
    .fl { gap: 40px; }
    .info b { font-size: 1.125rem; }
    .d { font-size: var(--t-caption); line-height: 1.5; }
    .cl.live .pin { grid-template-columns: minmax(0, 1fr); align-content: center; gap: 16px; }
    .cl.live .fl { width: 100%; }
    .cl.live .key { width: min(38%, 150px); }
    .cl.live .info { min-height: 6.5em; align-content: start; }
  }
</style>
